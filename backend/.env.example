DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/database_name
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60
MAX_AGENT_STEPS=8
MAX_LLM_RETRIES=2
LLM_RETRY_BASE_SECONDS=1
LLM_RETRY_MAX_SECONDS=8
AGENT_LOOP_REPEAT_THRESHOLD=3
MAX_LLM_CONTEXT_CHARACTERS=60000
MAX_CONTEXT_TOOL_RESULT_CHARACTERS=12000
COMMAND_TIMEOUT_SECONDS=30
MAX_COMMAND_OUTPUT_BYTES_PER_STREAM=65536
COMMAND_TERMINATION_GRACE_SECONDS=2
COMMAND_APPROVAL_TIMEOUT_SECONDS=300
# ALLOWED_WORKSPACE_ROOT=/absolute/path/to/allowed/workspaces
# JSON 数组；留空配置时不允许跨域请求，禁止使用 "*"
WEB_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
